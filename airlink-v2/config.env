# ==============================================================
# Airlink V2 - System Configuration File (config.env)
# กำหนดค่าที่นี่ แล้วรัน sudo bash install.sh เพื่อให้มีผลทั้งระบบ
# ==============================================================

# --- 1. Database Settings (การตั้งค่าฐานข้อมูล) ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=air_db
DB_USER=root
DB_PASSWORD=123456789000

# --- 2. FreeRADIUS & Mikrotik Settings (การตั้งค่า RADIUS) ---
# Secret ที่นำไปกรอกในเมนู RADIUS ของ Mikrotik WinBox
RADIUS_SECRET=00c1d0a5a49919afd243af8837adcde3

# --- 3. Web & Network Ports (พอร์ตการทำงาน) ---
# พอร์ตที่ผู้ใช้เข้าใช้งานเว็บผ่าน Nginx (ค่าเริ่มต้น: 80)
HTTP_PORT=80
# พอร์ตภายในของ Backend Express API (ค่าเริ่มต้น: 5000)
BACKEND_PORT=5000
# พอร์ตภายในของ Frontend Next.js (ค่าเริ่มต้น: 3000)
FRONTEND_PORT=3000

# --- 4. System Settings (การตั้งค่าระบบ) ---
TIMEZONE=Asia/Bangkok
HOTSPOT_SSID=@Free-WiFi-Airlink
