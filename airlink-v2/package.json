{
  "name": "airlink-v2-monorepo",
  "version": "2.0.0",
  "private": true,
  "packageManager": "npm@11.19.0",
  "description": "Airlink Mikrotik V2 - Turborepo Monorepo (Frontend, Backend, Services)",
  "workspaces": [
    "frontend",
    "backend",
    "services"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "dev:frontend": "npm run dev --workspace=frontend",
    "dev:backend": "npm run dev --workspace=backend",
    "dev:services": "npm run dev --workspace=services",
    "frontend": "npm run dev --workspace=frontend",
    "backend": "npm run dev --workspace=backend",
    "services": "docker compose up -d db radius",
    "build": "turbo run build",
    "build:frontend": "npm run build --workspace=frontend",
    "build:backend": "npm run build --workspace=backend",
    "start": "turbo run start",
    "start:frontend": "npm run start --workspace=frontend",
    "start:backend": "npm run start --workspace=backend",
    "lint": "turbo run lint",
    "services:up": "docker compose up -d db radius",
    "services:down": "docker compose down"
  },
  "devDependencies": {
    "turbo": "^2.1.8"
  }
}
